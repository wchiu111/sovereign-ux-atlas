{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "server/**/*.ts",
    "src/app/types/atlasAssist.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
