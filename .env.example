# Public client configuration. This value must contain only a public endpoint URL.
# Leave unset in local Vite development to use the deterministic provider.
VITE_ATLAS_ASSIST_ENDPOINT=/api/atlas-assist

# Server-only Atlas Assist configuration. Never prefix credentials with VITE_.
OPENAI_API_KEY=
OPENAI_ATLAS_ASSIST_MODEL=gpt-5.6-luna
ATLAS_ASSIST_TIMEOUT_MS=12000
ATLAS_ASSIST_REQUESTS_PER_MINUTE=12

# Optional comma-separated cross-origin clients. Same-origin requests are allowed automatically.
ATLAS_ASSIST_ALLOWED_ORIGINS=
