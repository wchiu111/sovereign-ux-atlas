{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/case-studies", "destination": "/index.html" },
    { "source": "/case-studies/:path*", "destination": "/index.html" },
    { "source": "/experiments", "destination": "/index.html" },
    { "source": "/experiments/:path*", "destination": "/index.html" },
    { "source": "/frameworks", "destination": "/index.html" },
    { "source": "/frameworks/:path*", "destination": "/index.html" },
    { "source": "/case-study/:path*", "destination": "/index.html" },
    { "source": "/experiment/:path*", "destination": "/index.html" },
    { "source": "/framework/:path*", "destination": "/index.html" }
  ]
}
